# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/otakuverse)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/otakuverse"

# CLIENT_URL: Allowed frontend origin URL for CORS (e.g. https://your-app.onrender.com)
CLIENT_URL="http://localhost:3000"

# PORT: Port to run the server on (default 3000)
PORT=3000

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="your_secure_jwt_secret_phrase_here"

# VITE_API_URL: Frontend environment variable pointing to the Express backend API (e.g. https://your-backend.onrender.com)
VITE_API_URL="http://localhost:3000"
