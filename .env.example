# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/otakuverse)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/otakuverse"

# CLIENT_URL: Allowed frontend origin URL for CORS (e.g. https://your-app.onrender.com)
CLIENT_URL="http://localhost:3000"

# PORT: Port to run the server on (default 3000)
PORT=3000
